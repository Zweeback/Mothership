{
  "scenario": "ephemeral_secrets_and_redaction",
  "description": "Uses inert placeholders. Tests construct synthetic detector-shaped values only at runtime, so fixtures cannot be mistaken for usable credentials.",
  "raw_samples": [
    {
      "source": "workflow_env",
      "raw": "FILE_ID=fixture-file-id&confirm=<TOKEN_FIXTURE>&uuid=fixture-uuid"
    },
    {
      "source": "gdrive_signed_url",
      "raw": "https://drive.google.com/uc?export=download&id=fixture-file-id&token=<TOKEN_FIXTURE>"
    },
    {
      "source": "pinggy_rtmp_tunnel",
      "raw": "rtmp://example.invalid/live/<API_KEY_FIXTURE>"
    },
    {
      "source": "oauth_bearer_header",
      "raw": "Authorization: Bearer <OAUTH_FIXTURE>"
    },
    {
      "source": "jwt_token",
      "raw": "Authorization: Bearer <JWT_FIXTURE>"
    },
    {
      "source": "muxshed_api_key",
      "raw": "MUXSHED_API_KEY=<API_KEY_FIXTURE>"
    }
  ],
  "expected_redact_patterns": [
    "REDACTED_API_KEY",
    "REDACTED_TOKEN",
    "REDACTED_JWT",
    "REDACTED_BEARER"
  ]
}
